# Copy to .env and replace all example secrets. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional paid alternative: ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
